                <mxCell id="mvtaqRwGueVQ5SMC4cEj-6" value="ダメージ計算を自動実行" style="whiteSpace=wrap;html=1;dashed=0;align=center;fontSize=12;shape=rect;fillColor=#e0e0e0;strokeColor=none;fontStyle=1;shadow=1" vertex="1" parent="mvtaqRwGueVQ5SMC4cEj-4">
